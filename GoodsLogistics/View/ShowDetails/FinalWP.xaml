<Window x:Class="GoodsLogistics.View.CalculateWP"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodsLogistics.View"
        mc:Ignorable="d"
        Title="Итоговое wp"
         SizeToContent="WidthAndHeight" 
MaxWidth="800" MaxHeight="700"

        Height="400" Width="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="LightBlue">

    <Window.Resources>
        <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- ScrollViewer для прокрутки -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Итоговое wp -->
                <TextBlock Text="Итоговое wp:" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="Bold" 
                           Margin="0,0,0,4" 
                           FontSize="14"/>

                <TextBox Text="{Binding FinalWp}" 
                         FontFamily="Consolas" 
                         FontSize="14" 
                         Style="{StaticResource BaseTextBoxStyle}" 
                         Margin="0,0,0,16" 
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="False"
                         IsReadOnly="True"/>

                <!-- Условия определённости -->
                <TextBlock Text="Условия определённости:" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="Bold" 
                           Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding DefinednessNotes}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF7E6" 
                                    CornerRadius="4" 
                                    Padding="12" 
                                    BorderBrush="LightGray" 
                                    BorderThickness="1"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding}" 
                                           Foreground="#B36B00" 
                                           TextWrapping="Wrap" 
                                           Style="{StaticResource BaseTextBlockStyle}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Закрыть" 
                        Width="100" 
                        HorizontalAlignment="Right" 
                        Click="CloseButton_Click"
                        Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>