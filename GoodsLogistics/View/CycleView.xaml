<UserControl x:Class="GoodsLogistics.Views.CycleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="LightBlue">

    <UserControl.Resources>
        <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Режим цикла:" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                          DisplayMemberPath="Name" Margin="0,0,0,10" Height="28" FontSize="13"/>

                <GroupBox Header="Генератор массива" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Длина:" Width="50" Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBox Text="{Binding Length}" Width="60" Style="{StaticResource BaseTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Мин:" Width="50" Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBox Text="{Binding MinVal}" Width="60" Style="{StaticResource BaseTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Макс:" Width="50" Style="{StaticResource BaseTextBlockStyle}"/>
                            <TextBox Text="{Binding MaxVal}" Width="60" Style="{StaticResource BaseTextBoxStyle}"/>
                        </StackPanel>
                        <Button Content="Сгенерировать" Command="{Binding GenerateCommand}"
                                Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Массив (редактируемый):" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ArrayInputText, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource BaseTextBoxStyle}"/>

                <TextBlock Text="Порог T (для Count&gt;T):" Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" Style="{StaticResource BaseTextBoxStyle}"/>

                <Button Content="Сброс" Command="{Binding ResetCommand}" Margin="0,0,0,5" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                <Button Content="Шаг" Command="{Binding StepCommand}" Margin="0,0,0,5" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                <Button Content="Пуск (Авто)" Command="{Binding RunCommand}" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Правая панель -->
            <StackPanel Grid.Column="1">
                <!-- Таблица массива -->
                <TextBlock Text="Массив данных (текущий j подсвечен жёлтым):"
                           Style="{StaticResource BaseTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding ArrayItems}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="5" Background="White">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="Background" Value="#FFFACD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Value}"
                                           Width="50" TextAlignment="Center"
                                           FontFamily="Trebuchet MS" FontSize="13"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Блок Инварианта с ДВУМЯ индикаторами -->
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
                    <StackPanel>
                        <TextBlock Text="Блок: Инвариант и Вариант" FontWeight="Bold" FontSize="15" Margin="0,0,0,5" Style="{StaticResource BaseTextBlockStyle}"/>

                        <TextBlock Text="{Binding SelectedMode.InvariantText}" FontStyle="Italic" Margin="0,0,0,5" Style="{StaticResource BaseTextBlockStyle}"/>
                        <TextBlock Text="{Binding SelectedMode.InvariantFormula}" FontFamily="Consolas" Foreground="Blue" Margin="0,0,0,10" Style="{StaticResource BaseTextBlockStyle}"/>

                        <!-- Два индикатора -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="14" Height="14" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvTrueBefore}" Value="True">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInvTrueBefore}" Value="False">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="До шага" Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <Ellipse Width="14" Height="14" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvTrueAfter}" Value="True">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInvTrueAfter}" Value="False">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="После шага" Style="{StaticResource BaseTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding InvStatusText}" FontWeight="Bold" Margin="0,0,0,5" Style="{StaticResource BaseTextBlockStyle}"/>

                        <TextBlock Text="Вариант-функция t(j):" Margin="0,0,0,2" Style="{StaticResource BaseTextBlockStyle}"/>
                        <ProgressBar Value="{Binding VariantProgress}" Maximum="100" Height="18" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding VariantStatusText}" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource BaseTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Блок WP -->
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
                    <StackPanel>
                        <TextBlock Text="Блок: Проверка сохранения (wp)" FontWeight="Bold" FontSize="15" Margin="0,0,0,5" Style="{StaticResource BaseTextBlockStyle}"/>
                        <TextBlock Text="{Binding WpExplanation}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Style="{StaticResource BaseTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 4 Условия корректности -->
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Background="White">
                    <StackPanel>
                        <TextBlock Text="4 Условия корректности цикла" FontWeight="Bold" FontSize="15" Margin="0,0,0,5" Style="{StaticResource BaseTextBlockStyle}"/>
                        <TextBlock Text="{Binding CorrectnessConditions}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Style="{StaticResource BaseTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>