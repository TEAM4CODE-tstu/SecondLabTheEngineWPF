<Window x:Class="GoodsLogistics.Views.StepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаги выполнения"
        Height="350" Width="500" Background="LightBlue"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Стиль для текста шагов, чтобы сохранить единообразие -->
        <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Шаги выполнения алгоритма" 
                       Style="{StaticResource BaseTextBlockStyle}" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       Margin="0,0,0,15"
                       Foreground="#333"/>

            <!-- Список шагов -->
            <ListBox ItemsSource="{Binding Steps}" 
                     BorderBrush="LightGray" 
                     BorderThickness="1"
                     Background="White"
                     MinHeight="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource BaseTextBoxStyle}">
                            <Run Text="через "/>
                            <Run Text="{Binding Operator}" FontWeight="Bold" Foreground="#007ACC"/>
                            <Run Text=" → "/>
                            <Run Text="{Binding Condition}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Закрыть" 
                    Width="100" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0"
                    Click="CloseButton_Click"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
