<Window x:Class="GoodsLogistics.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка пользователя" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" >
    <Window.Resources>
        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Background="LightBlue">
        <StackPanel Margin="20">
            <TextBlock Text="Инструкция по использованию программы" 
                       FontSize="18" FontWeight="Bold" 
                       Margin="0,0,0,16" />

            <TextBlock Text="{Binding HelpText}" 
           Style="{StaticResource HelpTextStyle}" 
           Margin="0,0,0,8"/>

        </StackPanel>
    </Grid>
</Window>
