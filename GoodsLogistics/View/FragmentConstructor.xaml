<UserControl x:Class="GoodsLogistics.Views.FragmentConstructor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="470" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Базовые стили текста и полей -->
        <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль кнопок действий (основные кнопки) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <!-- Стиль прозрачных кнопок-пресетов -->
        <Style x:Key="TransparentPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1F5FE"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <!-- Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B3E5FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Основная сетка: слева панель пресетов, справа контент -->
    <Grid Background="LightBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: Пресеты -->
        <Border Grid.Column="0" Padding="12, 20, 12, 12" BorderBrush="LightGray" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Пресеты" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Margin="0,0,0,16"/>

                <TextBlock x:Name="PresetLabel" 
                           Text="Ничего не выбрано" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="SemiBold" 
                           Foreground="#555555"
                           Margin="0,0,0,16"
                           VerticalAlignment="Center"/>

                <!-- Кнопки пресетов -->
                <Button Content="Max из двух" 
                        Click="OnPresetClicked"  
                        Command="{Binding LoadPresetCommand}" 
                        CommandParameter="Max" 
                        Style="{StaticResource TransparentPresetButtonStyle}"/>

                <Button Content="Квадратное уравнение" 
                        Click="OnPresetClicked"  
                        Command="{Binding LoadPresetCommand}" 
                        CommandParameter="Quad" 
                        Style="{StaticResource TransparentPresetButtonStyle}"/>

                <Button Content="Последовательность" 
                        Click="OnPresetClicked"  
                        Command="{Binding LoadPresetCommand}" 
                        CommandParameter="Seq" 
                        Style="{StaticResource TransparentPresetButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ: Основные поля и результаты -->
        <StackPanel  Grid.Column="1"  Margin="5,0,0,0">

            <TextBlock Text="Цель (Post)" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Margin="2,8,0,5"/>

            <TextBlock Text="Кратко:" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           Margin="2,0,0,4"/>
            <TextBox Text="{Binding PostText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource BaseTextBoxStyle}" 
                         Margin="2,0,0,10"/>

            <TextBlock Text="Пояснение:" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           Margin="2,0,0,4"/>
            <TextBox Text="{Binding PostHumanText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource BaseTextBoxStyle}" 
                         IsReadOnly="True" 
                         Margin="2,0,0,14"/>


            <TextBlock Text="Код фрагмента" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Margin="2,0,0,4"/>
            <TextBlock Text="Присваивания, if-else; без циклов" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           Foreground="#474b4e" 
                           Margin="2,0,0,8"/>

            <TextBox Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="50"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"
                         Margin="2,0,0,12"
                         Background="White"
                         BorderBrush="LightGray"
                         BorderThickness="1"/>



            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Рассчитать wp" 
                            Command="{Binding CalculateCommand}" 
                            Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="Показать шаги" 
                            Command="{Binding ShowStepsCommand}" 
                            Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="Показать триаду" 
                            Command="{Binding ShowTriadCommand}" 
                            Style="{StaticResource ActionButtonStyle}"/>

            </StackPanel>

            <TextBlock Text="{Binding ErrorText}" 
                           Foreground="IndianRed" 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           TextWrapping="Wrap" 
                           Margin="7,0,0,16"/>
        </StackPanel>
    </Grid>
</UserControl>
