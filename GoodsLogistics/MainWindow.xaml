<Window x:Class="GoodsLogistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SortingAggregator.ViewModels"
        xmlns:View="clr-namespace:GoodsLogistics.Views"  
        Title=" Администратор процесса погрузки "
        Height="500" Width="1080"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Конвертер bool в цветовые индикаторы  соответсвия постусловия (зелёный/красный) -->
        <Style x:Key="IndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="LightGray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreMet}" Value="True">
                    <Setter Property="Fill" Value="Green"/> 
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreMet}" Value="False">
                    <Setter Property="Fill" Value="IndianRed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <TabControl>
        <TabItem Header="Контракты в интерфейсе">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Добавленное-->
                <Grid Grid.Column="0" Background="LightBlue">
                    <!-- Закраска левого заднего плана в серый -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- Строка для списка (займет все место сверху) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка для кнопки справки-->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка для кнопки выход -->
                    </Grid.RowDefinitions>

                    <!-- Перенесенный список (Grid.Row="0") -->
                    <ListBox Grid.Row="0"
                  ItemsSource="{Binding Operations}"
             DisplayMemberPath="DisplayName"
             SelectedItem="{Binding SelectedOperation}"
                         Background="Transparent"
                         FontSize="16"
             FontFamily="Trebuchet MS"
             FontWeight="SemiBold" 
             HorizontalContentAlignment="Center"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
             Margin="8,8,8,4"/>

                    <!-- Размещение кнопки справки -->
                    <Button Grid.Row="1"
                Content="Справка пользователя"
                Height="32"
                Margin="8,4,8,4"
                Background="LightGray"
                FontSize="16"
             FontFamily="Trebuchet MS"
                FontWeight="SemiBold"
                Click="HelpButton_Click"/>

                    <!-- Размещение кнопки выхода в самом низу колонки -->
                    <Button Grid.Row="2"
                Content="Выход"
                Height="32"
                Margin="8,4,8,8"
                Background="#ff7575"
                                             FontSize="16"
             FontFamily="Trebuchet MS"
                FontWeight="SemiBold"
                Click="ExitButton_Click"/>


                </Grid>


                <!-- Правая панель -->
                <Grid Grid.Column="1" Background="LightBlue">

                    <Border Margin="0" Padding="16" Background="Transparent"
                BorderBrush="LightGray" BorderThickness="0" CornerRadius="0">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedOperation}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Заголовок -->
                                <TextBlock Text="{Binding DisplayName}"
                               FontSize="20" FontFamily="Trebuchet MS" FontWeight="Bold" Margin="0,0,0,16"/>

                                <!-- Ввод -->
                                <TextBlock Text="Введите веса прибывших грузов (через пробел, запятую или ;):" Margin="0,0,0,4"/>
                                <TextBlock Text="Возможно ввести не более 100 грузов весом не более 20 кг каждый" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" Padding="4"/>

                                <!-- Горизонтальная линия управления конвейером -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">

                                    <!-- Кнопка Выполнить -->
                                    <Button Content="Выполнить"
                Command="{Binding ExecuteCommand}"
                Width="140" Height="36" 
                FontSize="14" FontWeight="Bold"
                Background="LightGray"/>

                                    <!-- КОМБОБОКС (Виден только при Оптимизации погрузки) -->
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayName}" Value="Оптимизация погрузки">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Тип сортировки:" FontFamily="Trebuchet MS" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="180" Height="36" VerticalContentAlignment="Center" Background="LightGray" SelectedIndex="0" FontSize="13" FontWeight="Bold"
                                        SelectedValuePath="Content"
                                        SelectedValue="{Binding SelectedSortType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="Подсчётом"/>
                                            <ComboBoxItem Content="Быстрая"/>
                                            <ComboBoxItem Content="Слиянием"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- ТЕКСТБОКС ВРЕМЕНИ (Виден только при Оптимизации погрузки) -->
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayName}" Value="Оптимизация погрузки">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Время выполнения:" FontFamily="Trebuchet MS" FontSize="14" FontWeight="Bold"   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <!-- Поле вывода времени связано со свойством ExecutionTime-->
                                        <TextBox Text="{Binding ExecutionTime, StringFormat={}{0:F3} мс}"
                                         Width="100" Height="36"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FontSize="14" FontWeight="Bold"
                                         IsReadOnly="True"
                                         Background="LightGray"
                                         BorderBrush="LightGray"/>
                                    </StackPanel>

                                </StackPanel>

                                <!-- Индикаторы Pre или Post -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Style="{StaticResource IndicatorStyle}"
                                 Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PreStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Ellipse Width="16" Height="16" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPostMet}" Value="True">
                                                        <Setter Property="Fill" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPostMet}" Value="False">
                                                        <Setter Property="Fill" Value="IndianRed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding PostStatus}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Результат -->
                                <TextBlock Text="Результат:" FontWeight="Bold" FontSize="16" FontFamily="Trebuchet MS" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ResultText, TargetNullValue='—'}"
                               FontFamily="Trebuchet MS" FontSize="14" 
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <!-- Кнопка контракта -->
                                <Button Content="Показать контракт"
                                    Background="LightGray"
                                    Height="36" FontSize="14"
                            Command="{Binding ShowContractCommand}"
                                    FontFamily="Trebuchet MS"
                            Width="160" HorizontalAlignment="Left"
                            Padding="8,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Конструктор фрагмента">
            <View:FragmentConstructor/>
        </TabItem>
    </TabControl>
</Window>
